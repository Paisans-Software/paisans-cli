# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Site {{ .Site.Name }}'s Beszel agent. The token is this site's credential at
# the hub, so this file is 0600 and the compose file names it nowhere.
HUB_URL={{ .Agent.HubURL }}
TOKEN={{ .Agent.Token }}
KEY={{ .Agent.Key }}
SYSTEM_NAME={{ .Agent.Name }}
# The agent dials the hub and listens for nothing.
DISABLE_SSH=true
DOCKER_HOST=unix:///var/run/docker.sock
DATA_DIR={{ .DataDir }}
