# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans.yaml or secrets.enc.yaml.
#
# Every name below is paisans-invite's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
INVITE_LISTEN_ADDR=:{{ .App.Port }}
INVITE_PUBLIC_URL={{ .PublicURL }}
INVITE_DATABASE_URL={{ .DSN }}
# 32 random bytes each, generated by `paisans init` and never replaced by it.
# Changing the session key signs everyone out; changing the email hash key
# forgets every declined address.
INVITE_SESSION_KEY={{ .Secret "session_key" }}
INVITE_EMAIL_HASH_KEY={{ .Secret "email_hash_key" }}
# Both are the public URL of apps.{{ .App.Name }}.settings.identity_app, from its
# hostname in paisans.yaml, so they are always the same and a renamed identity
# host reaches this service on the next apply.
INVITE_OIDC_ISSUER={{ .Invite.IdentityURL }}
INVITE_IDP_URL={{ .Invite.IdentityURL }}
INVITE_OIDC_CLIENT_ID={{ .OIDC.ClientID }}
INVITE_OIDC_CLIENT_SECRET={{ .OIDC.ClientSecret }}
INVITE_MEMBER_GROUP={{ .OIDCMemberGroup }}
INVITE_ADMIN_GROUP={{ .OIDCAdminGroup }}
# The identity app's static API key, with which the service creates each
# approved member's account and has Pocket ID email their sign-in link.
INVITE_IDP_API_KEY={{ .Invite.APIKey }}
INVITE_SMTP_HOST={{ envquote .SMTP.Host }}
INVITE_SMTP_PORT={{ .SMTP.Port }}
INVITE_SMTP_USER={{ envquote .SMTP.Username }}
INVITE_SMTP_PASSWORD={{ envquote .SMTP.Password }}
INVITE_SMTP_FROM={{ envquote .SMTP.FromAddress }}
INVITE_SMTP_TLS={{ if .SMTP.Secure }}tls{{ else }}starttls{{ end }}
# The identity app's accent_color, so the invite pages match its sign-in
# page. Empty when that is unset or `default`, and the service keeps its own.
INVITE_ACCENT_COLOR={{ .Invite.Accent }}
INVITE_QUOTA={{ index .Invite.Settings "invite_quota" }}
INVITE_REQUIRE_APPROVAL={{ index .Invite.Settings "require_approval" }}
INVITE_LIFETIME_DAYS={{ index .Invite.Settings "invite_lifetime_days" }}
INVITE_APPLICATION_WAIT_DAYS={{ index .Invite.Settings "application_wait_days" }}
INVITE_DECLINE_RETENTION_DAYS={{ index .Invite.Settings "decline_retention_days" }}
INVITE_LOGIN_LINK_DAYS={{ index .Invite.Settings "login_link_days" }}
# Where compose.yaml mounts code-of-conduct.md, read only.
INVITE_COC_PATH=/etc/paisans-invite/code-of-conduct.md
# The gateway sets X-Forwarded-Proto and X-Forwarded-For, and the port is
# bound to the mesh address only, so the only client is a proxy.
INVITE_TRUST_FORWARDED=true
