# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
{{- if .App.Pinned }}
# {{ .App.Name }} is pinned to {{ .App.Site }}: app, database and media
# together, because a half pinned app is less available than either site alone.
{{- else }}
# {{ .App.Name }} has cluster placement: no Postgres service of its own, and a
# connection to the local HAProxy on {{ .DBHost }}:{{ .DBPort }}.
{{- end }}
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "app" }}
    restart: unless-stopped
    env_file:
      - .env
    # The mesh address only. Docker's own iptables rules bypass a host
    # firewall, so a port published on every interface of a host with a
    # public address is reachable from the internet whatever ufw says. The
    # gateway, over the mesh, is the only thing that should reach it.
    ports:
      - "{{ .MeshAddress }}:{{ .App.Port }}:{{ .App.Port }}"
{{- if .LocalStorage }}
    # data/ holds every attachment, and is a bind mount Docker creates as
    # root. The image runs as nodejs (uid 1001) and only its own copy of the
    # directory is chowned to it (Dockerfile:41-47 at 65be53c, the commit
    # 1.10.0 is built from), so Outline could not write an upload to the
    # bind. This starts as root, hands the one directory to nodejs, not
    # recursively, and drops to nodejs for good with setpriv before the
    # image's own entrypoint runs. Replacing the entrypoint drops the image's
    # CMD, so it is restated. Checked by running 1.10.0 with a root owned bind
    # at /var/lib/outline/data: setpriv is in the image, and nodejs could
    # write there after the chown.
    user: "0:0"
    entrypoint: ["sh", "-c", "chown nodejs:nodejs /var/lib/outline/data && exec setpriv --reuid=nodejs --regid=nodejs --init-groups docker-entrypoint.sh \"$$@\"", "sh"]
    command: ["node", "build/server/index.js"]
{{- end }}
    volumes:
      # Where the image keeps local file storage, and the path it declares as
      # a VOLUME: FILE_STORAGE_LOCAL_ROOT_DIR, read from the 1.10.0 image with
      # `docker image inspect`. It used to be mounted at /data, which nothing
      # in the image reads, so every container got an anonymous volume here
      # as well.
{{- if .LocalStorage }}
      # FILE_STORAGE is local in .env, so this holds every attachment.
{{- else }}
      # FILE_STORAGE is s3 in .env and Outline then never opens this directory
      # (build/server/storage/files/index.js:22), but it is a bind rather than
      # a tmpfs: switched to local storage, it would hold every attachment.
{{- end }}
      - {{ .DataPath }}/data:/var/lib/outline/data
{{- if .App.Pinned }}
    depends_on:
      - postgres

  postgres:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "postgres" }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    volumes:
      - {{ .DataPath }}/postgres:{{ .PostgresDataMount }}
{{- end }}

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
