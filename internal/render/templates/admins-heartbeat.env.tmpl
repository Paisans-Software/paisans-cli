# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Where this instance of {{ .App.Name }}, on {{ .App.Site }}, pushes the
# admins group's health: the ping route of every monitor, with the one token
# every instance of {{ .App.Name }} shares. The token is the whole credential,
# so this file is 0600 and the compose file names it nowhere.
ADMINS_HEARTBEAT_URLS={{ .URLs }}
{{- if .DNS }}
# The DNS continuity check's two heartbeats: the same monitors, each under its
# own token, which is as much a credential as the one above.
{{- range .DNS }}
{{ .Var }}={{ .URLs }}
{{- end }}
{{- end }}
