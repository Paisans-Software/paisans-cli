# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# One container: the gate. It runs the sign-in (/oauth2/start, the single
# registered callback, /oauth2/sign_out) and answers the gateway's
# forward_auth on /oauth2/auth for every app that sets gated or auto_login. It
# admits members only, through OAUTH2_PROXY_ALLOWED_GROUPS, which fails closed:
# a session outside the group is refused, never waved through.
#
# The port is fixed rather than derived: 4180, this kind's port in
# internal/render/plan.go's appPort, declared here as a literal.
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ .Image "app" }}
    restart: unless-stopped
    env_file:
      - .env
    # The mesh address only. Docker's own iptables rules bypass a host
    # firewall, so a port published on every interface of a host with a
    # public address is reachable from the internet whatever ufw says. The
    # gateway, over the mesh, is the only thing that should reach it.
    ports:
      - "{{ .MeshAddress }}:4180:4180"
    environment:
      OAUTH2_PROXY_HTTP_ADDRESS: "0.0.0.0:4180"
      # Who the gate answers 202 for: members, the group every member facing
      # app's client admits by default. validate holds an app using the gate
      # to the same group.
      OAUTH2_PROXY_ALLOWED_GROUPS: "members"
      # /oauth2/auth answers for Caddy; nothing is proxied through this
      # container. A static upstream keeps that honest.
      OAUTH2_PROXY_UPSTREAMS: "static://202"
    healthcheck:
      test: ["CMD", "/bin/oauth2-proxy", "--version"]
      interval: 30s
      timeout: 5s
      retries: 3

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
