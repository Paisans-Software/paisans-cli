# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans-stack.yaml or secrets.enc.yaml.
#
# Every name below is paisans-account-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP=account
PAISANS_SITE=home-a
ACCOUNT_LISTEN_ADDR=:8082
# The primary hostname: sign in, the home page, a member's own account and
# /admin.
ACCOUNT_PUBLIC_URL=https://account.example.org
# apps.account.settings.signup: invite (a member's invite link) or
# open (a registration page). Under open the service registers no invite
# route, and the settings below that belong to invite links are not rendered.
ACCOUNT_SIGNUP=open
# The join hostname: the pages for people with no account yet, the invite
# links or the registration page.
ACCOUNT_JOIN_PUBLIC_URL=https://join.example.org
# The operators in paisans-stack.yaml, which the service never bans, recovers
# or gives a new address or name: they change those in paisans-stack.yaml.
ACCOUNT_OPERATORS=alice,bob
ACCOUNT_DATABASE_URL=postgresql://account:fixture-not-a-secret-account-db@10.44.0.1:5000/account
# 32 random bytes each, generated by `paisans init` and never replaced by it.
# Changing the session key signs everyone out; changing the email hash key
# forgets every declined address.
ACCOUNT_SESSION_KEY=Zml4dHVyZS1ub3QtYS1zZWNyZXQtaW52aXRlLXNlc3M
ACCOUNT_EMAIL_HASH_KEY=Zml4dHVyZS1ub3QtYS1zZWNyZXQtaW52aXRlLWhhc2g
# Both are the public URL of the deployment's one pocket-id app, from its
# hostname in paisans-stack.yaml, so they are always the same and a renamed identity
# host reaches this service on the next apply.
ACCOUNT_OIDC_ISSUER=https://id.example.org
ACCOUNT_IDP_URL=https://id.example.org
ACCOUNT_OIDC_CLIENT_ID=fixture-not-a-secret-account-id
ACCOUNT_OIDC_CLIENT_SECRET=fixture-not-a-secret-account-secret
ACCOUNT_MEMBER_GROUP=members
ACCOUNT_ADMIN_GROUP=admins
# The identity app's static API key, with which the service creates each
# approved member's account and has Pocket ID email their sign-in link.
ACCOUNT_IDP_API_KEY=fixture-not-a-secret-auth-static-api
ACCOUNT_SMTP_HOST=smtp.example.org
ACCOUNT_SMTP_PORT=587
ACCOUNT_SMTP_USER=robot@example.org
ACCOUNT_SMTP_PASSWORD=fixture-not-a-secret-smtp
ACCOUNT_SMTP_FROM=hello@example.org
ACCOUNT_SMTP_TLS=starttls
# The identity app's accent_color, so the account pages match its sign-in
# page. Empty when that is unset or `default`, and the service keeps its own.
ACCOUNT_ACCENT_COLOR="#2f6f5e"
ACCOUNT_REQUIRE_APPROVAL=true
ACCOUNT_APPLICATION_WAIT_DAYS=14
ACCOUNT_DECLINE_RETENTION_DAYS=183
ACCOUNT_LOGIN_LINK_DAYS=7
# Where compose.yaml mounts code-of-conduct.md, read only. Everyone who signs
# up agrees to it, in either mode.
ACCOUNT_COC_PATH=/etc/paisans-account-service/code-of-conduct.md
# The gateway sets X-Forwarded-Proto and X-Forwarded-For, and the port is
# bound to the mesh address only, so the only client is a proxy.
ACCOUNT_TRUST_FORWARDED=true
