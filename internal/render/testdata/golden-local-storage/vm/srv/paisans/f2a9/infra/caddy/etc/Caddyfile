# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Inventory driven: a pinned app's hostname points at its location, everything
# else is proxied to the sites holding the apps role.
#
# DNS-01 for every hostname. With HTTP-01 a server can only obtain a
# certificate for a name that already points at it, so a new gateway could not
# hold valid certificates until DNS moved, and DNS should not move to a server
# without them. DNS-01 proves control through the provider's API and needs no
# inbound reachability at all, which is what makes moving the gateway an
# overlap rather than a cutover. It is also the only option for a hostname
# served behind a VPN, where nothing on the internet can answer a challenge.
#
# This file holds only what is cross cutting: certificates, the trusted proxy
# range, and one host block per application. How an application is routed is a
# fact about that application, so it lives in that blueprint's own snippet and
# is imported here.
{
	email admin@example.org
	acme_dns desec {
		token {env.ACME_DNS_TOKEN}
	}
	# The admin API on a socket inside this container, where `caddy reload`
	# run in it finds it. Caddy shares the host's network, where the
	# deployment's dials to loopback are dropped, and an admin API on TCP
	# there would be any local user's to rewrite.
	admin unix//run/caddy-admin.sock

	servers {
		# The mesh, never a host address, so the gateway role can move without
		# rewriting this. Applications behind it see the real client address
		# because this server is the only thing in front of them.
		trusted_proxies static 10.44.0.0/24
	}
}

# Every host block below imports this. When no site can serve an application,
# Caddy answers 502 (a refused or timed out dial, or a site that died mid
# request), 503 (every upstream already marked down) or 504, and a fediverse
# server receiving 502 for an inbox POST may count the delivery as failed for
# good. A 503 with Retry-After is the status that asks it to come back. Only
# errors Caddy raised itself reach handle_errors: an application's own 502, 503
# or 504 response is passed through untouched, so this never masks one.
(upstream_unavailable) {
	handle_errors 502 503 504 {
		header Retry-After 120
		respond "Service temporarily unavailable" 503
	}
}

# Imported inside the proxy directive of every application on more than one apps
# site, so the failover behaviour is set once rather than in each blueprint.
#
# first, not round robin: the apps sites are not interchangeable during a
# failover, and a dead one must simply be skipped. A dial that fails is retried
# on the next site within lb_try_duration, in the same request, for any method:
# Caddy retries a POST only when the connection never opened, so no body has
# been sent. A dead site on the mesh answers nothing, not even a reset, so
# dial_timeout is the whole price of trying it; lb_try_duration covers a full
# dial to each site. fail_duration is how long a failed site is skipped before
# one request tries it again.
#
# response_header_timeout bounds a request sent on a connection the gateway
# already had open to a site that has since died: nothing answers and nothing
# resets it, so without a bound the request waits for TCP to give up, which is
# minutes. 60s is twice the 30s long poll a Matrix client holds open on /sync,
# the longest wait for headers any blueprint here makes on purpose.
(upstream_failover) {
	lb_policy first
	lb_try_duration 5s
	fail_duration 30s
	transport http {
		dial_timeout 2s
		response_header_timeout 60s
	}
}

# Imported inside the proxy directive of an application, or a media route,
# served by one site on a machine other than the gateway's. That site can go
# down while the gateway stays up, and the same two bounds turn a dead site
# into upstream_unavailable's 503 instead of a request that hangs: 2s to open
# a connection, 60s for headers on one already open (see upstream_failover).
(upstream_single) {
	transport http {
		dial_timeout 2s
		response_header_timeout 60s
	}
}

# The gateway answers as this deployment at a path only it serves, with its
# token, and apply asks for it from outside after every gateway apply: a
# server that took 80 or 443 after admission answers anything else. Every
# host block imports it first, and holds nothing else at its top level that
# could answer: Caddy orders redir, rewrite, basic_auth, forward_auth and
# the like before handle, so a blueprint's routing always sits inside a
# handle of its own. Among handle blocks Caddy matches the one with a single,
# longest path first, so this one's one literal path wins over every other;
# a second matcher here would lose that.
(paisans_self) {
	@paisans_self path /.well-known/paisans/f2a9
	handle @paisans_self {
		respond "f2a9" 200
	}
}

# Named Caddy snippets, not a hostname's routing: imported here, at the top
# level, so that a site block below can import a name this file defines. See
# templates/oauth2-proxy/caddy.snippet.gates.tmpl for what it declares.
import /etc/caddy/snippets/gate-gates.caddy


account.example.org {
	import paisans_self
	import upstream_unavailable
	# Stripped here as on a gated hostname: nothing that reaches an app may
	# name a user unless the gate put the name there, and an ungated app that
	# trusted the header would otherwise trust whoever sent the request.
	request_header -X-Auth-Request-*

	handle {
		import /etc/caddy/snippets/account.caddy
	}
}


# Public, with auto-login: a member the gate has signed in goes straight into
# the app's own sign-in, and a visitor on its sign-in page with no gate session
# signs in at the gate first. Everything else is the public app. See
# docs/specs/2026-10-08-visibility-gate.md in the toolkit.
blog.example.org {
	import paisans_self
	import upstream_unavailable
	# Stripped here as on a gated hostname: nothing that reaches an app may
	# name a user unless the gate put the name there.
	request_header -X-Auth-Request-*

	# Auto-login: a member the gate has signed in goes straight into the
	# app's own sign-in, which completes without a prompt. Ahead of anything
	# else matching its path, so the session holder takes this. The gate
	# checks the session; blog_autologin stops a visitor it
	# refuses, or a member the app refuses, from being sent again for two
	# minutes.
	@autologin_0 {
		method GET HEAD
		header Accept *text/html*
		not header Authorization *
		path /login
		header Cookie *_oauth2_proxy*
		not header Cookie *blog_autologin*
	}
	handle @autologin_0 {
		import gate_autologin /oauth/generic blog_autologin
	}

	# Auto-login: a member the gate has signed in goes straight into the
	# app's own sign-in, which completes without a prompt. Ahead of anything
	# else matching its path, so the session holder takes this. The gate
	# checks the session; blog_autologin stops a visitor it
	# refuses, or a member the app refuses, from being sent again for two
	# minutes.
	@autologin_1 {
		method GET HEAD
		header Accept *text/html*
		not header Authorization *
		path /
		header Cookie *_oauth2_proxy*
		not header Cookie *wfu*
		not header Cookie *blog_autologin*
	}
	handle @autologin_1 {
		import gate_autologin /oauth/generic blog_autologin
	}

	# The app's sign-in page, with no gate session: sign in at the gate and
	# come back holding one, so the auto-login above fires.
	@gate_signin {
		method GET HEAD
		header Accept *text/html*
		not header Authorization *
		path /login
		not header Cookie *_oauth2_proxy*
		not header Cookie *blog_gatesignin*
	}
	handle @gate_signin {
		import gate_signin blog_gatesignin
	}

	handle {
		import /etc/caddy/snippets/blog.caddy
	}
}


