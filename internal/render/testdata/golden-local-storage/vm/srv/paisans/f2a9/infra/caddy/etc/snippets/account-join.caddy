# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# People with no account yet, on join.example.org, for account:
# signup is invite, so the invite pages, /i/<token>, and the static files,
# and nothing else.
# Never gated, because nobody here has an account yet. Sign in, the home
# page, a member's own account and /admin answer on the app's primary
# hostname only, and the service registers them there only, so a session
# cookie is never set on this origin.
@invitee path /i/* /static/*
handle @invitee {
	reverse_proxy 10.44.0.1:8082 10.44.0.2:8082 {
		# Failover across apps sites; see upstream_failover in the Caddyfile.
		import upstream_failover
		header_up X-Forwarded-Proto https
	}
}
handle {
	respond 404
}
