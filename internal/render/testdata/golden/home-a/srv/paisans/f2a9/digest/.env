# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans-stack.yaml or secrets.enc.yaml.
#
# Every name below is paisans-engagement-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP=digest
PAISANS_SITE=home-a
ENGAGEMENT_LISTEN_ADDR=:8083
# The hostname every unsubscribe link names.
ENGAGEMENT_PUBLIC_URL=https://digest.example.org
ENGAGEMENT_DATABASE_URL=postgresql://digest:fixture-not-a-secret-digest-db@10.44.0.1:5000/digest
# 32 random bytes, generated by `paisans init`. It signs every unsubscribe
# link, so changing it makes the links in every email already sent stop
# working.
ENGAGEMENT_SIGNING_KEY=fixture-not-a-secret-digest-signing
# Mbin's database, as a role that can only read it, and its public URL, which
# every link in the digest points into.
ENGAGEMENT_MBIN_DATABASE_URL=postgresql://digest_reader:fixture-not-a-secret-digest-reader@10.44.0.1:5000/talk
ENGAGEMENT_MBIN_URL=https://talk.example.org
# The digest names the community with the meta title: the community's name, or
# without one the name Mbin renders as KBIN_META_TITLE. The instance title is
# the name Mbin renders as KBIN_TITLE, which service releases before 0.2 need.
ENGAGEMENT_INSTANCE_TITLE=talk
ENGAGEMENT_META_TITLE=Fixture Community
# Empty when the deployment has no mail host: the service then sends nothing,
# and still answers its unsubscribe links. The port is rendered with a host
# only, since the service reads an empty one as 587 and refuses a 0.
ENGAGEMENT_SMTP_HOST=smtp.example.org
ENGAGEMENT_SMTP_PORT=587
ENGAGEMENT_SMTP_USER=robot@example.org
ENGAGEMENT_SMTP_PASSWORD=fixture-not-a-secret-smtp
ENGAGEMENT_SMTP_FROM=hello@example.org
ENGAGEMENT_SMTP_FROM_NAME=Example Community
ENGAGEMENT_SMTP_TLS=starttls
# The homeserver the bot runs on, and the MAS admin client it looks
# members up with, which the homeserver app's mas.yaml declares with the same
# id and secret. Without a homeserver none is rendered and the service keeps
# Matrix off.
ENGAGEMENT_MATRIX_URL=https://chat.example.org
ENGAGEMENT_MATRIX_SERVER_NAME=example.org
ENGAGEMENT_MAS_ADMIN_URL=http://10.44.0.3:18010
ENGAGEMENT_MAS_CLIENT_ID=0BXQYB18J3KW1N827Y4JAKKHGD
ENGAGEMENT_MAS_CLIENT_SECRET=fixture-not-a-secret-digest-mas-admin
ENGAGEMENT_MAS_UPSTREAM_PROVIDER=0F7E2P4F3W17YSR71ETCRS95ZY
ENGAGEMENT_MATRIX_BOT_LOCALPART=community-bot
ENGAGEMENT_MATRIX_BOT_DISPLAY_NAME=Community Bot
