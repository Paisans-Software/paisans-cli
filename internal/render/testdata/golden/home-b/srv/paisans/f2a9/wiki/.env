# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans-stack.yaml or secrets.enc.yaml.
#
# Changing a value means recreating the container, since Compose passes
# environment at start.
#
# Wiki.js 2.5 reads only its database from the environment; its sign-in, site
# settings and groups are the bootstrap's (bootstrap.env). Cited at v2.5.316.
PAISANS_APP=wiki
PAISANS_SITE=home-b
DB_TYPE=postgres
# Every DB_* is set, since the image's config.yml reads each one and an unset
# variable becomes the string "undefined" (server/helpers/config.js:22).
# DATABASE_URL wins over all but DB_TYPE (server/core/db.js:31-37).
DB_HOST=10.44.0.2
DB_PORT=5000
DB_USER=wiki
DB_PASS=fixture-not-a-secret-wiki-db
DB_NAME=wiki
DB_SSL=false
# The cluster's pg_hba.conf rejects every connection without TLS. The image's
# connection string parser ignores sslmode and reads ssl, and ssl=no-verify
# encrypts without checking the certificate, which is what sslmode=require
# means to the other apps (observed: paisans-cli
# docs/specs/2026-10-13-wikijs-blueprint-findings.md, step 1).
DATABASE_URL=postgresql://wiki:fixture-not-a-secret-wiki-db@10.44.0.2:5000/wiki?ssl=no-verify
# Every apps site runs an instance against this database, and each reloads
# configuration, sign-in and pages when another changes them, over Postgres
# LISTEN/NOTIFY (server/core/db.js:231-264).
HA_ACTIVE=true
