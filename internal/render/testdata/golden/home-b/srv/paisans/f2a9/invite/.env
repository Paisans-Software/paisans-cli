# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans-stack.yaml or secrets.enc.yaml.
#
# Every name below is paisans-invite's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP=invite
PAISANS_SITE=home-b
INVITE_LISTEN_ADDR=:8082
INVITE_PUBLIC_URL=https://invite.example.org
INVITE_DATABASE_URL=postgresql://invite:fixture-not-a-secret-invite-db@10.44.0.2:5000/invite
# 32 random bytes each, generated by `paisans init` and never replaced by it.
# Changing the session key signs everyone out; changing the email hash key
# forgets every declined address.
INVITE_SESSION_KEY=Zml4dHVyZS1ub3QtYS1zZWNyZXQtaW52aXRlLXNlc3M
INVITE_EMAIL_HASH_KEY=Zml4dHVyZS1ub3QtYS1zZWNyZXQtaW52aXRlLWhhc2g
# Both are the public URL of apps.invite.settings.identity_app, from its
# hostname in paisans-stack.yaml, so they are always the same and a renamed identity
# host reaches this service on the next apply.
INVITE_OIDC_ISSUER=https://id.example.org
INVITE_IDP_URL=https://id.example.org
INVITE_OIDC_CLIENT_ID=fixture-not-a-secret-invite-id
INVITE_OIDC_CLIENT_SECRET=fixture-not-a-secret-invite-secret
INVITE_MEMBER_GROUP=members
INVITE_ADMIN_GROUP=admins
# The identity app's static API key, with which the service creates each
# approved member's account and has Pocket ID email their sign-in link.
INVITE_IDP_API_KEY=fixture-not-a-secret-auth-static-api
INVITE_SMTP_HOST=smtp.example.org
INVITE_SMTP_PORT=587
INVITE_SMTP_USER=robot@example.org
INVITE_SMTP_PASSWORD=fixture-not-a-secret-smtp
INVITE_SMTP_FROM=hello@example.org
INVITE_SMTP_TLS=starttls
# The identity app's accent_color, so the invite pages match its sign-in
# page. Empty when that is unset or `default`, and the service keeps its own.
INVITE_ACCENT_COLOR="#2f6f5e"
INVITE_QUOTA=5
INVITE_REQUIRE_APPROVAL=true
INVITE_LIFETIME_DAYS=14
INVITE_APPLICATION_WAIT_DAYS=14
INVITE_DECLINE_RETENTION_DAYS=183
INVITE_LOGIN_LINK_DAYS=7
# Where compose.yaml mounts code-of-conduct.md, read only.
INVITE_COC_PATH=/etc/paisans-invite/code-of-conduct.md
# The gateway sets X-Forwarded-Proto and X-Forwarded-For, and the port is
# bound to the mesh address only, so the only client is a proxy.
INVITE_TRUST_FORWARDED=true
