# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change paisans-stack.yaml or secrets.enc.yaml.
#
# Every name below is paisans-ops-notifier-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP=notify
PAISANS_SITE=vm
OPS_NOTIFIER_LISTEN_ADDR=:8085
OPS_NOTIFIER_DATA_DIR=/data
# The operators in paisans-stack.yaml, by email. A Beszel user signed in
# through Pocket ID whose email is not here is deleted, with their alerts and
# settings.
OPS_NOTIFIER_OPERATOR_EMAILS=alice@example.org,bob@example.org
# The hub's API over the mesh, and this app's own superuser there, which the
# hub's setup.sh makes from the same password at every start. A PocketBase
# superuser is unscoped. The break glass user is never deleted.
OPS_NOTIFIER_BESZEL_URL=http://10.44.0.4:8084
OPS_NOTIFIER_BESZEL_EMAIL=paisans-link-notify@example.org
OPS_NOTIFIER_BESZEL_PASSWORD=fixture-not-a-secret-notify-hub
OPS_NOTIFIER_KEEP_EMAILS=beszel-admin@example.org
# The homeserver the bot runs on, by its public URL, which every alert URL
# names because Beszel refuses internal addresses for a user who is not an
# admin, and the MAS admin client it is made with, which the homeserver
# app's mas.yaml declares with the same id and secret.
OPS_NOTIFIER_MATRIX_URL=https://chat.example.org
OPS_NOTIFIER_MATRIX_SERVER_NAME=example.org
OPS_NOTIFIER_MAS_ADMIN_URL=http://10.44.0.3:18010
OPS_NOTIFIER_MAS_CLIENT_ID=7T01SD426QC8AQS08HGRT8WZS5
OPS_NOTIFIER_MAS_CLIENT_SECRET=fixture-not-a-secret-notify-mas-admin
OPS_NOTIFIER_MAS_UPSTREAM_PROVIDER=0F7E2P4F3W17YSR71ETCRS95ZY
OPS_NOTIFIER_BOT_LOCALPART=ops-bot
OPS_NOTIFIER_BOT_DISPLAY_NAME=Ops Bot
