# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Named Caddy snippets for the gate, imported by NAME (`import gate`,
# `import gate_autologin ...`, `import gate_signin ...`), never by path:
# nothing renders a host block for this file, and it carries no routing of its
# own until a host block imports one of these names.
#
# The gate admits members and admins (OAUTH2_PROXY_ALLOWED_GROUPS). A person
# needs a page, not oauth2-proxy's raw status, so a request with no session
# becomes a redirect to sign in, carrying a fixed body, which is how the
# monitor tells the gate's redirect from an app's own. Someone signed in who is
# in neither group gets oauth2-proxy's own 403. `rd` is not URL encoded, because Caddy has no
# placeholder that encodes one, so a deep link with more than one query
# parameter loses the extras on the first visit that crosses sign-in. The page
# is right; only extra parameters are lost.
#
# STRIP BEFORE FORWARDING. Whatever consumes X-Auth-Request-User must trust
# nothing upstream of Caddy: a client could forge the header on its way in.
# `request_header` (not `header`, which edits the response) removes it from the
# inbound request before forward_auth's subrequest can see it; copy_headers
# below only ever adds the verified header back, so it does nothing to remove
# one already forged. Every host block strips it too, for its other handles.

# gate is the gate itself, imported inside a gated host block's final
# `handle`: everything that reaches it needs a member's session.
(gate) {
	route {
		request_header -X-Auth-Request-*
		forward_auth 10.44.0.3:4180 {
			uri /oauth2/auth
			copy_headers X-Auth-Request-User X-Auth-Request-Email X-Auth-Request-Preferred-Username
			@gate_signin status 401
			handle_response @gate_signin {
				header Location "https://gate.example.org/oauth2/start?rd={http.request.scheme}://{http.request.host}{http.request.orig_uri}"
				respond "Sign in required by the visibility gate." 302
			}
		}
	}
}

# gate_autologin <target> <loop breaker> sends a member the gate has signed in
# to the app's own sign-in route, <target>, which completes without a prompt.
# A host block imports it on its auto-login paths, only when the gate's cookie
# is present. The cookie is checked here rather than trusted by name: a
# visitor whose session is gone, or who is not a member, is sent back to the
# page they asked for with the loop breaker set, so the host block's auto-login
# matcher passes them by for two minutes and they see the app as they would
# have. The loop breaker is also set on the way to <target>, so a member the
# app's own client refuses is sent there once rather than forever.
(gate_autologin) {
	route {
		forward_auth 10.44.0.3:4180 {
			uri /oauth2/auth
			@gate_refused status 4xx
			handle_response @gate_refused {
				header Set-Cookie "{args[1]}=1; Path=/; Max-Age=120; Secure; HttpOnly; SameSite=Lax"
				header Location {http.request.orig_uri}
				respond 302
			}
		}
		header Set-Cookie "{args[1]}=1; Path=/; Max-Age=120; Secure; HttpOnly; SameSite=Lax"
		# The * is required: a first argument starting with / is read as a
		# path matcher, and the redirect silently becomes an empty 200.
		redir * {args[0]} 302
	}
}

# gate_signin <loop breaker> sends a visitor with no gate session from a public
# app's sign-in page through the gate's sign-in, and back to the same page,
# now holding the session auto-login looks for. The loop breaker stops a
# visitor who abandons the sign-in from being sent there again for two
# minutes.
(gate_signin) {
	header Set-Cookie "{args[0]}=1; Path=/; Max-Age=120; Secure; HttpOnly; SameSite=Lax"
	redir "https://gate.example.org/oauth2/start?rd={http.request.scheme}://{http.request.host}{http.request.orig_uri}" 302
}
