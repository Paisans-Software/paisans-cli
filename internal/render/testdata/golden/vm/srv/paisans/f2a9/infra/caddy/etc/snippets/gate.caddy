# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Routing for gate, imported by the gateway's block for
# gate.example.org. This is the one hostname the identity provider's callback
# is registered against, and it is NOT gated itself: gating the gate is a
# redirect loop. Its whole surface is oauth2-proxy's own: /oauth2/start,
# /oauth2/callback, /oauth2/sign_out, and the /oauth2/auth endpoint the gate's
# named snippets forward-auth to (see caddy.snippet.gates.tmpl), so it proxies
# straight to the gate.
handle {
	reverse_proxy 10.44.0.3:4180 {
		header_up X-Forwarded-Proto https
	}
}
