# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Routing for digest, imported by the gateway's block for
# digest.example.org. Never gated: a member clicking unsubscribe from an inbox
# may not be signed in, and the signed token in the link is what names them.
# The unsubscribe links, /u/<token>, and the web digests, /d/<token>, which
# the Digest Bot's message links to, are the service's only pages. GET
# /healthz is a probe, answering ok or 503, forwarded so the monitor's
# public check sees the digest through the gateway. Nothing else is proxied.
@public expression `path('/u/*') || path('/d/*') || (method('GET') && path('/healthz'))`
handle @public {
	reverse_proxy 10.44.0.1:8083 10.44.0.2:8083 {
		# Failover across apps sites; see upstream_failover in the Caddyfile.
		import upstream_failover
		header_up X-Forwarded-Proto https
	}
}
handle {
	respond 404
}
