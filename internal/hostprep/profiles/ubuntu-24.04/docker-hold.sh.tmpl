{{- /* Run ahead of the install that brings docker-ce or containerd.io, whose
        scripts would start their system daemons; dockerd turns on
        forwarding, creates docker0 and adds its chains to the firewall as it
        starts. Debian's invoke-rc.d and deb-systemd-invoke ask
        /usr/sbin/policy-rc.d before they start a service, and 101 forbids
        it: so a policy-rc.d is put in place that forbids the units of the
        packages this install adds, and asks the owner's own, copied to
        policy-rc.d.paisans-owner, about every other. There is never a
        moment with no policy in place: admit's is written whole first, the
        owner's is copied, not moved, through a temporary name, so a copy cut
        short is never taken for the owner's, and admit's is renamed over
        it. When the
        shell exits, however it exits, confirm_claims runs first when the
        caller defines it (host admit records there what apt installed);
        an install that failed has its units disabled, since their
        packages' scripts may have enabled them before it failed; then the
        owner's goes back, or admit's is removed; one an interrupted run
        left is put right first. Saving the owner's policy is two simple
        commands, so set -e stops the shell, before the trap is set and
        before admit's policy is in place, when either fails. apt-get runs
        dpkg in a session of its own, so dpkg can outlive a killed apt-get
        and go on running a package's script, which may enable its units:
        the trap waits for dpkg, up to ten minutes, before it confirms,
        disables and releases, and keeps the hold, failing the step, when
        dpkg is still running then. */ -}}
set -e
{{ .Lock }}{{ .Release }}release_docker_hold
if [ -e /usr/sbin/policy-rc.d.paisans-owner ] || [ -L /usr/sbin/policy-rc.d.paisans-owner ]; then
  echo '/usr/sbin/policy-rc.d.paisans-owner is there beside a /usr/sbin/policy-rc.d that differs from it, and admit copies your own policy-rc.d to that name while it installs Docker. Keep the one you want as /usr/sbin/policy-rc.d, remove the other, and admit again'
  exit 1
fi
cat > /usr/sbin/.policy-rc.d.paisans-tmp <<'POLICY'
#!/bin/sh
# {{ .Marker }}
for a in "$@"; do
  case $a in {{ .Units }}) exit 101 ;; esac
done
if [ -x /usr/sbin/policy-rc.d.paisans-owner ]; then exec /usr/sbin/policy-rc.d.paisans-owner "$@"; fi
exit 0
POLICY
chmod 755 /usr/sbin/.policy-rc.d.paisans-tmp
if [ -e /usr/sbin/policy-rc.d ] || [ -L /usr/sbin/policy-rc.d ]; then
  cp -pP /usr/sbin/policy-rc.d /usr/sbin/.policy-rc.d.paisans-owner-tmp
  mv -f /usr/sbin/.policy-rc.d.paisans-owner-tmp /usr/sbin/policy-rc.d.paisans-owner
fi
wait_for_dpkg() {
  n=0
  while pgrep -x dpkg >/dev/null 2>&1; do
    [ "$n" -lt 600 ] || return 1
    sleep 1
    n=$((n+1))
  done
}
trap 'paisans_status=$?; if ! wait_for_dpkg; then echo "dpkg is still running after ten minutes, so the hold on the Docker daemons stays in place and its units are not yet disabled. Once dpkg is done, run host admit again, or host evict, which puts the hold back"; exit 1; fi; if command -v confirm_claims >/dev/null 2>&1; then confirm_claims || true; fi; if [ "$paisans_status" -ne 0 ]; then systemctl disable {{ .Disable }} >/dev/null 2>&1 || true; fi; release_docker_hold; exit "$paisans_status"' EXIT
trap 'exit 1' HUP INT TERM
mv -f /usr/sbin/.policy-rc.d.paisans-tmp /usr/sbin/policy-rc.d
