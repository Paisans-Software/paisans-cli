# Written by paisans host admit. Loads the table that keeps {{ .User }} off
# this host's loopback and the owner's network, before {{ .User }}'s
# manager, and so its Docker daemon and containers, can start: the manager
# requires this unit, so a table that fails to load keeps them stopped.
# Never restart it: its stop deletes the table, and a restart restarts the
# manager that requires it. A changed table is loaded in place with reload.
# It follows nftables.service, whose configuration flushes the whole
# ruleset: a reload of nftables loads this table again, leaving the manager
# running, and a restart or stop of nftables restarts or stops this unit,
# and so the manager, its daemon and its containers with it, so the
# deployment never runs while the table is gone.
[Unit]
Description=paisans {{ .Token }}: egress table for {{ .User }}
DefaultDependencies=no
After=nftables.service
PartOf=nftables.service
ReloadPropagatedFrom=nftables.service
Wants=network-pre.target
Before=network-pre.target user@{{ .UID }}.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/sbin/nft -f {{ .File }}
ExecReload=/usr/sbin/nft -f {{ .File }}
ExecStop=/usr/sbin/nft delete table inet {{ .Table }}

[Install]
WantedBy=multi-user.target
RequiredBy=user@{{ .UID }}.service
