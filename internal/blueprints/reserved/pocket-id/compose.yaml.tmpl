# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# The identity provider gates every other application, so it holds no state of
# its own that a promoted site would lack: its uploads go in the database
# rather than on disk, where they ride streaming replication with no sync job.
{{- if .App.Pinned }}
#
# Pinned to {{ .App.Site }}: its own database, at its own site.
{{- end }}
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ yamlquote (.Image "app") }}
    restart: unless-stopped
    # The standby wrapper, paisans-standby.sh beside this file, runs the
    # image's own entrypoint and command, which are spelled out here because
    # setting an entrypoint clears the image's command. Pocket ID admits one
    # instance per database, so on every apps site but one it stands by,
    # healthy, and retries every PAISANS_STANDBY_RETRY seconds (default 15).
    entrypoint: ["/bin/sh", "/paisans/pocket-id-standby.sh"]
    command: ["/app/docker/entrypoint.sh", "/app/pocket-id"]
    # The image's healthcheck (`/app/pocket-id healthcheck`, docker/
    # Dockerfile-prebuilt:20 at tag v2.14.0), passed by a standby through its
    # state file. Its timing is stated rather than inherited: the image checks
    # every 90s, which is also how long apply's gate would wait for a first
    # report, and a check that is a stat or one local request costs nothing.
    healthcheck:
      test: ["CMD-SHELL", "[ -f /tmp/paisans-standby ] || /app/pocket-id healthcheck"]
      interval: 30s
      timeout: 5s
      start_period: 30s
      start_interval: 5s
      retries: 3
    # Long enough for a clean shutdown, which halts the actors (a 10s grace,
    # backend/internal/bootstrap/actors_bootstrap.go:60) and then deregisters
    # this instance, so a standby takes over at its next retry. Docker's
    # default of 10s would kill it first and leave the registration to age out
    # over 90s.
    stop_grace_period: 30s
    env_file:
      - .env
    # The mesh address only. The gateway, over the mesh, is the only thing
    # that should reach it, and a port published on every interface would
    # answer anything the host's firewall lets in.
    ports:
      - "{{ .MeshAddress }}:{{ .App.Port }}:{{ .App.Port }}"
    volumes:
      - {{ .DataPath }}/data:/app/data
      - {{ .DataPath }}/paisans-standby.sh:/paisans/pocket-id-standby.sh:ro
      # Where the standby wrapper mirrors its marker for the reconciler.
      - {{ .DataPath }}/run:/paisans/run
{{- if .App.Pinned }}
    depends_on:
      - postgres
{{- end }}

  # The operator reconciler (docs/specs/2026-10-14-operators-and-management.md):
  # reads Pocket ID and writes nothing, and fails /healthz while an operator is
  # not an enabled member in the member group and in operators, or a Pocket ID
  # administrator is not an operator. It reaches Pocket ID as `app` on this
  # stack's own network with the STATIC_API_KEY above, so the key goes nowhere
  # it was not already. Beside a standby it reads the marker and does nothing,
  # and its /healthz says standby.
  reconciler:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ yamlquote (.Image "reconciler") }}
    restart: unless-stopped
    env_file:
      - .env
    # The mesh address only, for the uptime monitor's check of /livez.
    ports:
      - "{{ .MeshAddress }}:1412:1412"
    volumes:
      - {{ .DataPath }}/run:/paisans/run:ro
    depends_on:
      - app
{{- if .OperatorsHeartbeat }}

  # The operators heartbeat (internal/render/operatorsheartbeat.go): once a
  # minute it asks the reconciler's /healthz over this stack's network and
  # pushes its answer to every monitor's public hostname, from the active
  # instance only. The URLs carry a token and stay in
  # operators-heartbeat/heartbeat.env, which is 0600; it never reads .env,
  # which holds the static API key. It dials out and listens for nothing.
  operators-heartbeat:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ yamlquote .HeartbeatImage }}
    restart: unless-stopped
    env_file:
      - operators-heartbeat/heartbeat.env
    entrypoint: ["/bin/sh", "/push.sh"]
    volumes:
      - {{ .DataPath }}/operators-heartbeat/push.sh:/push.sh:ro
    depends_on:
      - reconciler
{{- end }}
{{- if .App.Pinned }}

  postgres:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ yamlquote (.Image "postgres") }}
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ .DBName }}
      POSTGRES_USER: {{ .DBUser }}
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD:?set in .env}
    volumes:
      - {{ .DataPath }}/postgres:{{ .PostgresDataMount }}
{{- end }}

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
