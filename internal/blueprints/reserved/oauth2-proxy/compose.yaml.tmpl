# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# One container: the gate. It runs the sign-in (/oauth2/start, the single
# registered callback, /oauth2/sign_out) and answers the gateway's
# forward_auth on /oauth2/auth for every app that sets gated or auto_login. It
# admits members and admins, through OAUTH2_PROXY_ALLOWED_GROUPS, which fails
# closed: a session outside both groups is refused, never waved through.
#
# The port is fixed rather than derived: 4180, this blueprint's port in
# internal/render/plan.go's appPort, declared here as a literal.
name: {{ .Project }}

services:
  app:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
    image: {{ yamlquote (.Image "app") }}
    restart: unless-stopped
    env_file:
      - .env
    # The mesh address only. The gateway, over the mesh, is the only thing
    # that should reach it, and a port published on every interface would
    # answer anything the host's firewall lets in.
    ports:
      - "{{ .MeshAddress }}:4180:4180"
    environment:
      OAUTH2_PROXY_HTTP_ADDRESS: "0.0.0.0:4180"
      # Who the gate answers 202 for: members, the group every member facing
      # app's client admits by default, and admins, since an admin can see
      # everything a member can. The same two groups as the gate's client at
      # Pocket ID (blueprints.OIDCClient). validate holds an app using the gate
      # to the same member group. A comma separated list: oauth2-proxy reads it
      # through viper, which splits a string on commas into a list
      # (pkg/apis/options/load.go:27-55 at v7.15.4; viper v1.21.0,
      # viper.go:977-1022).
      OAUTH2_PROXY_ALLOWED_GROUPS: {{ yamlquote (print .OIDCMemberGroup "," .OIDCAdminGroup) }}
      # /oauth2/auth answers for Caddy; nothing is proxied through this
      # container. A static upstream keeps that honest.
      OAUTH2_PROXY_UPSTREAMS: "static://202"
    healthcheck:
      test: ["CMD", "/bin/oauth2-proxy", "--version"]
      interval: 30s
      timeout: 5s
      retries: 3

# Every network carries the deployment label too, so that what owns it is
# read from the label rather than guessed from its name.
networks:
  default:
    labels:
      {{ .DeploymentLabel }}: "{{ .DeploymentID }}"
