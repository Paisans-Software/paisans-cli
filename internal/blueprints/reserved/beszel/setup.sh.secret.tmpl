#!/bin/sh
# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Converges Beszel's sign in on {{ .App.Name }} through the PocketBase v0.40.5
# API, at every start of this container, so the hub holds what
# {{ configFile }} and the secrets file say whatever was changed in its UI:
#
#   * the users collection's OAuth2 settings, one provider, oidc, at the
#     deployment's Pocket ID with this app's client;
#   * the break glass user's password, which USER_PASSWORD sets on a new
#     install only. The user and the superuser are separate accounts
#     (beszel-docs user-accounts.md:3-5), and admin sets the superuser's;
#   * the hub's SMTP settings and sender, from the deployment's smtp block,
#     when it names a host.
#
# It signs in as the superuser admin has just set, so it carries
# admin_password, the client secret and the SMTP password, and is 0600.
# Every request body is a quoted here-document, so no value in it passes
# through the shell. The image has curl and a shell but no jq, so the two
# values read back are cut out with sed. Success leaves the container running asleep, so `restart: on-failure`
# restarts it only when a step failed.
set -eu

hub=http://app:8090

# PocketBase's health route answers 200 with no authentication
# (apis/health.go:11-25). The hub is healthy before admin runs and admin
# before this, so the wait covers only a hub restarted in between.
tries=0
until [ "$(curl -s -o /dev/null -w '%{http_code}' "$hub/api/health")" = 200 ]; do
	tries=$((tries + 1))
	if [ "$tries" -ge 60 ]; then
		echo "setup: the hub at $hub did not answer /api/health with 200 in two minutes" >&2
		exit 1
	fi
	sleep 2
done

# A superuser signs in at the _superusers auth collection with identity and
# password (apis/record_auth_with_password.go:102-105), and the reply's token
# goes in the Authorization header as it is.
auth=$(curl -sS --fail-with-body -X POST "$hub/api/collections/_superusers/auth-with-password" \
	-H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"identity":{{ jsonquote .Beszel.AdminEmail }},"password":{{ jsonquote (.Secret "admin_password") }}}
JSON
)
token=$(printf '%s' "$auth" | sed -n 's/.*"token":"\([^"]*\)".*/\1/p')
if [ -z "$token" ]; then
	echo "setup: signing in as the superuser answered without a token" >&2
	exit 1
fi
{{- if .OIDC.Present }}

# The oauth2 field of an auth collection, and each provider's fields, are
# core/collection_model_auth_options.go:126, :407-413 and :527-543. Beszel's
# UI offers a provider whose name starts with oidc as its OpenID Connect
# button (internal/site/src/components/login/auth-form.tsx:50-51), and
# PocketBase's oidc provider is that name (tools/auth/oidc.go:27). The list
# written is the whole list, so a provider added in the UI is removed.
curl -sS --fail-with-body -o /dev/null -X PATCH "$hub/api/collections/users" \
	-H "Authorization: $token" -H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"oauth2":{"enabled":true,"providers":[{"name":"oidc","displayName":"Pocket ID","clientId":{{ jsonquote .OIDC.ClientID }},"clientSecret":{{ jsonquote .OIDC.ClientSecret }},"authURL":{{ jsonquote .OIDC.AuthorizationEndpoint }},"tokenURL":{{ jsonquote .OIDC.TokenEndpoint }},"userInfoURL":{{ jsonquote .OIDC.UserinfoEndpoint }},"pkce":true}]}}
JSON
{{- end }}

# The break glass user, by its email, which is unique in an auth collection
# (core/collection_model.go:1036-1060). A superuser sets a password without
# the old one (forms/record_upsert.go:184-193). The address is
# beszel-admin@ under community.domain, which holds only letters, digits,
# hyphens and dots, so it is safe in the filter below. An operator who has
# deleted the user keeps it deleted.
#
# Setting the password on every start, even to the value it already has,
# stores a new bcrypt hash, and PocketBase gives an auth record a new token
# key whenever its stored password changes (core/record_model.go,
# onRecordSaveExecute), which signs out every break glass session. That is
# intended: break glass is for while the identity provider is down, and a
# session of it does not outlive the next start of this container.
users=$(curl -sS --fail-with-body -G "$hub/api/collections/users/records" \
	-H "Authorization: $token" --data-urlencode "filter=email='{{ .Beszel.AdminEmail }}'" --data-urlencode 'fields=id')
id=$(printf '%s' "$users" | sed -n 's/.*"items":\[{"id":"\([^"]*\)".*/\1/p')
if [ -n "$id" ]; then
	curl -sS --fail-with-body -o /dev/null -X PATCH "$hub/api/collections/users/records/$id" \
		-H "Authorization: $token" -H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"password":{{ jsonquote (.Secret "admin_password") }},"passwordConfirm":{{ jsonquote (.Secret "admin_password") }}}
JSON
else
	echo "setup: no user {{ .Beszel.AdminEmail }} to set the password of; the superuser's is set"
fi

# A superuser for each app that consumes beszel-hub and shares a
# beszel_superuser_password, as paisans-link-<app>@<domain>, created or given
# that password; then every other paisans-link- superuser deleted, so an app
# removed from the deployment loses its access at the next start. The
# _superusers collection has no API rules, so only a superuser lists,
# creates, updates and deletes its records (PocketBase v0.40.5
# migrations/1640988000_init.go:291-313 sets none), and PocketBase refuses
# only the deletion of the last superuser
# (core/record_model_superusers.go:19-41), which the break glass one never
# is. App names and the domain hold only letters, digits, hyphens and dots,
# so each address is safe in a filter. A PocketBase superuser is unscoped:
# the app can read and change everything in the hub.
keep=""
{{- range ($.Consumers "beszel-hub") }}
{{- if index .Secrets "beszel_superuser_password" }}
link="paisans-link-{{ .Name }}@{{ $.Domain }}"
keep="$keep $link"
found=$(curl -sS --fail-with-body -G "$hub/api/collections/_superusers/records" \
	-H "Authorization: $token" --data-urlencode "filter=email='$link'" --data-urlencode 'fields=id')
lid=$(printf '%s' "$found" | sed -n 's/.*"items":\[{"id":"\([^"]*\)".*/\1/p')
if [ -n "$lid" ]; then
	curl -sS --fail-with-body -o /dev/null -X PATCH "$hub/api/collections/_superusers/records/$lid" \
		-H "Authorization: $token" -H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"password":{{ jsonquote (index .Secrets "beszel_superuser_password") }},"passwordConfirm":{{ jsonquote (index .Secrets "beszel_superuser_password") }}}
JSON
else
	curl -sS --fail-with-body -o /dev/null -X POST "$hub/api/collections/_superusers/records" \
		-H "Authorization: $token" -H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"email":"paisans-link-{{ .Name }}@{{ $.Domain }}","password":{{ jsonquote (index .Secrets "beszel_superuser_password") }},"passwordConfirm":{{ jsonquote (index .Secrets "beszel_superuser_password") }}}
JSON
fi
{{- end }}
{{- end }}
# PocketBase writes a record's fields in name order, so each item of the list
# reads {"email":...,"id":...}.
links=$(curl -sS --fail-with-body -G "$hub/api/collections/_superusers/records" \
	-H "Authorization: $token" --data-urlencode "filter=email~'paisans-link-'" --data-urlencode 'fields=id,email' \
	--data-urlencode 'perPage=500')
printf '%s' "$links" | tr '{' '\n' | sed -n 's/^"email":"\([^"]*\)","id":"\([^"]*\)".*/\1 \2/p' |
	while read -r email lid; do
		case " $keep " in
		*" $email "*) ;;
		*)
			curl -sS --fail-with-body -o /dev/null -X DELETE "$hub/api/collections/_superusers/records/$lid" \
				-H "Authorization: $token"
			echo "setup: deleted the superuser of an app that no longer consumes this hub"
			;;
		esac
	done

{{- if .SMTP.Host }}

# The settings API takes a superuser's PATCH and binds the body onto the
# current settings (apis/settings.go:14-16 and :51-59), so only the fields
# written here change. smtp's fields and meta's sender are
# core/settings_model.go:363-382 and :529-530. tls is implicit TLS when true;
# false sends STARTTLS when the server offers it (core/settings_model.go
# :372-376), and the username makes it required in effect, since the PLAIN
# auth sends no credentials unencrypted (tools/mailer/smtp.go:65-72);
# validate warns about starttls with no username
# (beszel-starttls-not-enforced). localName is left as the hub has it: the
# toolkit has no setting for it. PocketBase requires a sender name
# (core/settings_model.go:541), so the community's name stands in for an
# unset from_name.
curl -sS --fail-with-body -o /dev/null -X PATCH "$hub/api/settings" \
	-H "Authorization: $token" -H 'Content-Type: application/json' --data-binary @- <<'JSON'
{"smtp":{"enabled":true,"host":{{ jsonquote .SMTP.Host }},"port":{{ .SMTP.Port }},"username":{{ jsonquote .SMTP.Username }},"password":{{ jsonquote .SMTP.Password }},"authMethod":"PLAIN","tls":{{ .SMTP.Secure }}},"meta":{"senderName":{{ jsonquote (or .SMTP.FromName .CommunityName) }},"senderAddress":{{ jsonquote .SMTP.FromAddress }}}}
JSON
echo "setup: the hub's sign in and mail are written"
{{- else }}

# The deployment's smtp block names no host, so the hub's mail settings are
# left as they are: PocketBase's default is SMTP off, and an operator who
# sets SMTP in the hub's own settings page keeps it.
echo "setup: the hub's sign in is written; no smtp host, so its mail is left as it is"
{{- end }}
trap 'exit 0' TERM INT
while :; do
	sleep 86400 &
	wait $!
done
