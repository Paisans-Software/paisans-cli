# Rendered by paisans. Do not edit.
#
# Every hub variable below was read from Beszel v0.21.1 and its
# beszel-docs environment-variables.md at that release. The hub also reads
# each with a BESZEL_HUB_ prefix (internal/hub/utils/utils.go:10-16),
# which nothing here sets.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
# Its public URL, for the links it writes (internal/hub/hub.go:131-134).
APP_URL={{ .PublicURL }}
# An operator's first sign in through Pocket ID creates their user
# (internal/hub/collections.go:32-37), as a user, never an admin
# (internal/users/users.go:28-49).
USER_CREATION=true
OAUTH_DEFAULT_USER_ROLE=user
# Every user sees every system, so none has to be added to one
# (internal/hub/collections.go:56).
SHARE_ALL_SYSTEMS=true
# Pocket ID is the only sign in: password sign in is off on the users
# collection, set again at every start (internal/hub/collections.go:27-29).
# The superuser's own sign in is another collection's and stays, over the
# mesh only; it is how an operator turns password sign in back on for the
# break glass user while the identity provider is down.
DISABLE_PASSWORD_AUTH=true
# The hub never dials an agent: every agent dials it, over the mesh
# (internal/hub/systems/system.go:72-76).
DISABLE_SSH=true
# The break glass user and superuser a new install makes, for when the
# identity provider is down (internal/migrations/initial-settings.go:25-61).
# The user signs in only once the superuser turns password sign in back on.
# Read on a new install only; admin and setup apply a rotated password. The
# password is apps.<app>.admin_password in the secrets file, and nothing is
# sent to the address.
USER_EMAIL={{ .Beszel.AdminEmail }}
USER_PASSWORD={{ .Secret "admin_password" }}
# Where the Caddy in front of the hub connects from. The hub honours a
# forwarded authentication header only from these addresses
# (internal/hub/api.go:98-118), and none is configured, so nothing is.
TRUSTED_PROXY_IPS={{ .TrustProxy }}
# No call to GitHub for a newer release: the core catalog's track decides
# which hub runs (internal/hub/api.go:183).
CHECK_UPDATES=false
# Not the hub's: compose reads these beside compose.yaml for admin's
# command, so the password is never written into compose.yaml.
BESZEL_ADMIN_EMAIL={{ .Beszel.AdminEmail }}
BESZEL_ADMIN_PASSWORD={{ .Secret "admin_password" }}
