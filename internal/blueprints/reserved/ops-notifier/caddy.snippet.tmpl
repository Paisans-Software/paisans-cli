# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Routing for {{ .App.Name }}, imported by the gateway's block for
# {{ .Hostname }}. The service serves GET /healthz alone, answering ok while
# its state file is readable, so the monitor's public check sees it through
# the gateway. Nothing else is proxied.
@health expression `method('GET') && path('/healthz')`
handle @health {
	reverse_proxy{{ range .Upstreams }} {{ . }}{{ end }} {
{{- if gt (len .Upstreams) 1 }}
		# Failover across apps sites; see upstream_failover in the Caddyfile.
		import upstream_failover
{{- else if .UpstreamElsewhere }}
		# One site, not the gateway's machine; see upstream_single in the Caddyfile.
		import upstream_single
{{- end }}
	}
}
handle {
	respond 404
}
