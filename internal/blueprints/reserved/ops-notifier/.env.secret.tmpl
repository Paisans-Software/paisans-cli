# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# Every name below is paisans-ops-notifier-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
OPS_NOTIFIER_LISTEN_ADDR=:{{ .App.Port }}
OPS_NOTIFIER_DATA_DIR=/data
# The operators in {{ configFile }}, by email. A Beszel user signed in
# through Pocket ID whose email is not here is deleted, with their alerts and
# settings.
OPS_NOTIFIER_OPERATOR_EMAILS={{ envquote .OpsNotifier.OperatorEmails }}
{{- if .HasLinked "beszel-hub" }}
# The hub's API over the mesh, and this app's own superuser there, which the
# hub's setup.sh makes from the same password at every start. A PocketBase
# superuser is unscoped. The break glass user is never deleted.
OPS_NOTIFIER_BESZEL_URL={{ .Linked "beszel-hub" "url" }}
OPS_NOTIFIER_BESZEL_EMAIL=paisans-link-{{ .App.Name }}@{{ .Domain }}
OPS_NOTIFIER_BESZEL_PASSWORD={{ .Secret "beszel_superuser_password" }}
OPS_NOTIFIER_KEEP_EMAILS=beszel-admin@{{ .Domain }}
{{- end }}
{{- if and (.HasLinked "matrix-homeserver") (.LinkedOffers "matrix-homeserver" "mas_admin_url") }}
# The homeserver the bot runs on, by its public URL, which every alert URL
# names because Beszel refuses internal addresses for a user who is not an
# admin, and the MAS admin client it is made with, which the homeserver
# app's mas.yaml declares with the same id and secret.
OPS_NOTIFIER_MATRIX_URL={{ .Linked "matrix-homeserver" "base_url" }}
OPS_NOTIFIER_MATRIX_SERVER_NAME={{ .Linked "matrix-homeserver" "server_name" }}
OPS_NOTIFIER_MAS_ADMIN_URL={{ .Linked "matrix-homeserver" "mas_admin_url" }}
OPS_NOTIFIER_MAS_CLIENT_ID={{ stableULID (printf "%s-mas-admin" .App.Name) }}
OPS_NOTIFIER_MAS_CLIENT_SECRET={{ .Secret "mas_admin_client_secret" }}
OPS_NOTIFIER_MAS_UPSTREAM_PROVIDER={{ stableULID (.LinkedApp "matrix-homeserver") }}
{{- end }}
OPS_NOTIFIER_BOT_LOCALPART={{ .Setting "bot_localpart" "ops-bot" }}
OPS_NOTIFIER_BOT_DISPLAY_NAME={{ envquote (.Setting "bot_display_name" "Ops Bot") }}
