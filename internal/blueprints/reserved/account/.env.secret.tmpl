# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# Every name below is paisans-account-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
ACCOUNT_LISTEN_ADDR=:{{ .App.Port }}
ACCOUNT_PUBLIC_URL={{ .PublicURL }}
ACCOUNT_DATABASE_URL={{ .DSN }}
# 32 random bytes each, generated by `paisans init` and never replaced by it.
# Changing the session key signs everyone out; changing the email hash key
# forgets every declined address.
ACCOUNT_SESSION_KEY={{ .Secret "session_key" }}
ACCOUNT_EMAIL_HASH_KEY={{ .Secret "email_hash_key" }}
# Both are the public URL of apps.{{ .App.Name }}.settings.identity_app, from its
# hostname in {{ configFile }}, so they are always the same and a renamed identity
# host reaches this service on the next apply.
ACCOUNT_OIDC_ISSUER={{ .Account.IdentityURL }}
ACCOUNT_IDP_URL={{ .Account.IdentityURL }}
ACCOUNT_OIDC_CLIENT_ID={{ .OIDC.ClientID }}
ACCOUNT_OIDC_CLIENT_SECRET={{ .OIDC.ClientSecret }}
ACCOUNT_MEMBER_GROUP={{ envquote .OIDCMemberGroup }}
ACCOUNT_ADMIN_GROUP={{ envquote .OIDCAdminGroup }}
# The identity app's static API key, with which the service creates each
# approved member's account and has Pocket ID email their sign-in link.
ACCOUNT_IDP_API_KEY={{ .Account.APIKey }}
ACCOUNT_SMTP_HOST={{ envquote .SMTP.Host }}
ACCOUNT_SMTP_PORT={{ .SMTP.Port }}
ACCOUNT_SMTP_USER={{ envquote .SMTP.Username }}
ACCOUNT_SMTP_PASSWORD={{ envquote .SMTP.Password }}
ACCOUNT_SMTP_FROM={{ envquote .SMTP.FromAddress }}
ACCOUNT_SMTP_TLS={{ if .SMTP.Secure }}tls{{ else }}starttls{{ end }}
# The identity app's accent_color, so the account pages match its sign-in
# page. Empty when that is unset or `default`, and the service keeps its own.
ACCOUNT_ACCENT_COLOR={{ .Account.Accent }}
ACCOUNT_INVITE_QUOTA={{ index .Account.Settings "invite_quota" }}
ACCOUNT_REQUIRE_APPROVAL={{ index .Account.Settings "require_approval" }}
ACCOUNT_INVITE_LIFETIME_DAYS={{ index .Account.Settings "invite_lifetime_days" }}
ACCOUNT_APPLICATION_WAIT_DAYS={{ index .Account.Settings "application_wait_days" }}
ACCOUNT_DECLINE_RETENTION_DAYS={{ index .Account.Settings "decline_retention_days" }}
ACCOUNT_LOGIN_LINK_DAYS={{ index .Account.Settings "login_link_days" }}
# Where compose.yaml mounts code-of-conduct.md, read only.
ACCOUNT_COC_PATH=/etc/paisans-account-service/code-of-conduct.md
# The gateway sets X-Forwarded-Proto and X-Forwarded-For, and the port is
# bound to the mesh address only, so the only client is a proxy.
ACCOUNT_TRUST_FORWARDED=true
