# Rendered by paisans. Do not edit: `paisans apply` overwrites this file.
#
# Routing for {{ .App.Name }}, imported by the gateway's block for
# {{ .Hostname }}. Never gated: the service checks every sign-in itself.
#
# The invite pages answer on the join hostname only, and the service
# registers them there only, so /i/* is refused here as well, in either
# signup mode: an invite link opened on this hostname would otherwise reach
# the origin that holds a member's session. The bare / here is the member's
# home page, and is proxied; the registration page of open signup is / on the
# join hostname.
@invitepages path /i/*
respond @invitepages 404
reverse_proxy{{ range .Upstreams }} {{ . }}{{ end }} {
{{- if gt (len .Upstreams) 1 }}
	# Failover across apps sites; see upstream_failover in the Caddyfile.
	import upstream_failover
{{- else if .UpstreamElsewhere }}
	# One site, not the gateway's machine; see upstream_single in the Caddyfile.
	import upstream_single
{{- end }}
	header_up X-Forwarded-Proto https
}
