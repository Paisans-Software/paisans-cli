# Rendered by paisans. Do not edit.
#
# Every name below was read from the fork's src/config.js and src/server.js
# at 1.1.0-oidc.2.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
# Not 3000, the fork's default: Wiki.js publishes 3000, and two apps on one
# site publish on the same mesh address.
PORT={{ .App.Port }}
PUBLIC_BASE_URL={{ .PublicURL }}
# Exactly where the proxy in front of the monitor connects from: this site's
# mesh address behind its own Caddy, or where the operator's web server
# reaches the published port from. The login rate limiter is keyed on the
# client address, and only a trusted proxy's X-Forwarded-For is read.
TRUST_PROXY={{ .TrustProxy }}
SESSION_SECRET={{ .Secret "session_secret" }}
# The break glass sign in, for when the identity provider is down. With a
# client below, sign-in is SSO only and this account is the one password
# sign-in left, at /login?local=1. The password is apps.<app>.admin_password
# in the secrets file.
ADMIN_USER=admin
ADMIN_PASS={{ .Secret "admin_password" }}
DB_DRIVER=sqlite
SQLITE_PATH=/data/uptime.sqlite
# A full VACUUM rewrites the whole file every six hours and buys nothing at
# steady state; beside etcd it is the one burst of I/O worth refusing. See
# docs/specs/2026-10-07-uptime-monitoring.md, "Beside etcd".
RETENTION_VACUUM=false
SEED_FILE=/seed/monitors.json
{{- if .OIDC.Present }}
OIDC_ISSUER={{ .OIDC.Issuer }}
OIDC_CLIENT_ID={{ .OIDC.ClientID }}
OIDC_CLIENT_SECRET={{ .OIDC.ClientSecret }}
OIDC_BUTTON_LABEL=Sign in with {{ .Domain }}
# Only this group is admitted; editor and viewer stay unset, so everyone else
# is refused (src/lib/oidc.js roleFromClaims).
OIDC_ADMIN_GROUP={{ .Setting "admin_group" "" }}
# SSO only. Read from the fork at v1.1.0-oidc.4 on 2026-10-11: the login page
# sends everyone straight to the provider (src/routes/auth.js:26), the
# password form stays reachable at /login?local=1 (auth.js:33-36), and a
# password sign-in is refused for anyone but ADMIN_USER (auth.js:43-47;
# README.md:302). So the break glass above survives and nobody else signs
# in with a password. The fork refuses to start this way if ADMIN_PASS is
# unset or "admin" (src/lib/oidc.js:180-186); render refuses both first.
# Users cannot disconnect SSO from their account
# (src/routes/settings.js:1049), which changes nothing here, where SSO is the
# only way in.
OIDC_DISABLE_PASSWORD_LOGIN=true
{{- end }}
