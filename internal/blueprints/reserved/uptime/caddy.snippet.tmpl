# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Routing for {{ .App.Name }}, imported by the host block for
# {{ .Hostname }} in the Caddy on the monitor's own site. The UI, sign in,
# the OIDC callback, heartbeat URLs (/ping/*) and the UI's own session
# authenticated JSON (/api/sites*, which the dashboard's live refresh and the
# response time chart fetch) pass. Badges, /metrics and the token API
# (/api/v1/*) are refused here whatever the app's own settings say: /metrics
# is public whenever no API token exists, which under this toolkit is always.
# Express ignores a trailing slash, so /metrics/ is refused too; Caddy's path
# matcher already ignores case.
{{- if .SettingBool "public_status_page" true }}
#
# The public status page (/status, /status.json, /status.rss) passes too. The
# seed shows only each app's check at its public hostname on it, and hides
# every check that names a mesh address or a site.
{{- else }}
#
# The public status page is off (settings.public_status_page), so /status*
# is refused as well.
{{- end }}
@refused path{{ if not (.SettingBool "public_status_page" true) }} /status*{{ end }} /badge/* /metrics /metrics/ /api/v1/*
respond @refused 404
reverse_proxy{{ range .Upstreams }} {{ . }}{{ end }} {
{{- if .UpstreamElsewhere }}
	# One site, not the gateway's machine; see upstream_single in the Caddyfile.
	import upstream_single
{{- end }}
	header_up X-Forwarded-Proto https
}
