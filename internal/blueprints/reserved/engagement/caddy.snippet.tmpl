# Rendered by paisans. Do not edit: `paisans deployment apply` overwrites this file.
#
# Routing for {{ .App.Name }}, imported by the gateway's block for
# {{ .Hostname }}. Gated, the gate admits a request to /d/ only for a signed
# in member and leaves /u/ and /healthz open: a member clicking unsubscribe
# from an inbox may not be signed in, and the signed token in the link is
# what names them. The unsubscribe links, /u/<token>, and the web digests,
# /d/<week>, which the bot's message links to and which name the member by
# the gate's header, are the service's only pages. GET
# /healthz is a probe, answering ok or 503, forwarded so the monitor's
# public check sees the digest through the gateway. Nothing else is proxied.
# The hostname has no page of its own. The front page and /d/ with no date
# send a visitor to the account app, the community's front door: /d/ before
# the gate, as an open path, and the front page once the gate admits them.
@home path / /d /d/ /d/preview /d/preview/
handle @home {
	redir {{ .Engagement.HomeURL }} 302
}
@public expression `path('/u/*') || path('/d/*') || (method('GET') && path('/healthz'))`
handle @public {
	reverse_proxy{{ range .Upstreams }} {{ . }}{{ end }} {
{{- if gt (len .Upstreams) 1 }}
		# Failover across apps sites; see upstream_failover in the Caddyfile.
		import upstream_failover
{{- else if .UpstreamElsewhere }}
		# One site, not the gateway's machine; see upstream_single in the Caddyfile.
		import upstream_single
{{- end }}
		header_up X-Forwarded-Proto https
	}
}
handle {
	respond 404
}
