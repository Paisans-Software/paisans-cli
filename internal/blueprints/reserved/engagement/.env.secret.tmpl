# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans deployment apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# Every name below is paisans-engagement-service's environment contract, read from its
# internal/config/config.go, which is the whole of its environment.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
ENGAGEMENT_LISTEN_ADDR=:{{ .App.Port }}
# The hostname every unsubscribe link names.
ENGAGEMENT_PUBLIC_URL={{ .PublicURL }}
ENGAGEMENT_DATABASE_URL={{ .DSN }}
# 32 random bytes, generated by `paisans init`. It signs every unsubscribe
# link, so changing it makes the links in every email already sent stop
# working.
ENGAGEMENT_SIGNING_KEY={{ .Secret "digest_signing_key" }}
# Mbin's database, as a role that can only read it, and its public URL, which
# every link in the digest points into.
ENGAGEMENT_MBIN_DATABASE_URL={{ .Engagement.SourceDSN }}
ENGAGEMENT_MBIN_URL={{ .Engagement.SourceURL }}
# The names Mbin renders as KBIN_TITLE and KBIN_META_TITLE. The email names the
# community with the meta title, and its button with the instance title.
ENGAGEMENT_INSTANCE_TITLE={{ envquote .Engagement.InstanceTitle }}
ENGAGEMENT_META_TITLE={{ envquote .Engagement.MetaTitle }}
# Empty when the deployment has no mail host: the service then sends nothing,
# and still answers its unsubscribe links. The port is rendered with a host
# only, since the service reads an empty one as 587 and refuses a 0.
ENGAGEMENT_SMTP_HOST={{ envquote .SMTP.Host }}
ENGAGEMENT_SMTP_PORT={{ if .SMTP.Host }}{{ .SMTP.Port }}{{ end }}
ENGAGEMENT_SMTP_USER={{ envquote .SMTP.Username }}
ENGAGEMENT_SMTP_PASSWORD={{ envquote .SMTP.Password }}
ENGAGEMENT_SMTP_FROM={{ envquote .SMTP.FromAddress }}
ENGAGEMENT_SMTP_FROM_NAME={{ envquote .SMTP.FromName }}
ENGAGEMENT_SMTP_TLS={{ or .SMTP.Security "starttls" }}
{{- if and (.HasLinked "matrix-homeserver") (.LinkedOffers "matrix-homeserver" "mas_admin_url") }}
# The homeserver the Digest Bot runs on, and the MAS admin client it looks
# members up with, which the homeserver app's mas.yaml declares with the same
# id and secret. Without a homeserver none is rendered and the service keeps
# Matrix off.
ENGAGEMENT_MATRIX_URL={{ .Linked "matrix-homeserver" "base_url" }}
ENGAGEMENT_MATRIX_SERVER_NAME={{ .Linked "matrix-homeserver" "server_name" }}
ENGAGEMENT_MAS_ADMIN_URL={{ .Linked "matrix-homeserver" "mas_admin_url" }}
ENGAGEMENT_MAS_CLIENT_ID={{ stableULID (printf "%s-mas-admin" .App.Name) }}
ENGAGEMENT_MAS_CLIENT_SECRET={{ .Secret "mas_admin_client_secret" }}
ENGAGEMENT_MAS_UPSTREAM_PROVIDER={{ stableULID (.LinkedApp "matrix-homeserver") }}
ENGAGEMENT_MATRIX_BOT_LOCALPART={{ .Setting "bot_localpart" "digest-bot" }}
{{- end }}
