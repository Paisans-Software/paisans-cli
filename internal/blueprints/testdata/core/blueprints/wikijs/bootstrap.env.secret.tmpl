# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# The bootstrap's environment (Paisans-Software/wikijs-bootstrap, README.md,
# "Environment"). It reads it once per start of its container, so a change
# reaches Wiki.js when apply recreates the stack.
#
# Wiki.js by service name on the stack's own network, never through the
# gateway, which refuses /finalize.
WIKI_URL=http://app:{{ .App.Port }}
# The same database as Wiki.js's .env, in the same form: the bootstrap reads
# ssl=no-verify as sslmode=require, and a DSN with neither as a pinned wiki's
# own Postgres, without TLS.
{{- if .App.Pinned }}
DATABASE_URL={{ .DSN }}
{{- else }}
DATABASE_URL={{ .DSN }}?ssl=no-verify
{{- end }}
PUBLIC_URL={{ .PublicURL }}
# The break glass admin, user 1, created by setup and in Administrators. The
# bootstrap signs in as it; nobody reaches it in a browser by accident.
ADMIN_EMAIL=wikijs-admin@{{ .Domain }}
ADMIN_PASSWORD={{ .Secret "local_admin_password" }}
OAUTH_CLIENT_ID={{ .OIDC.ClientID }}
OAUTH_CLIENT_SECRET={{ .OIDC.ClientSecret }}
OAUTH_AUTHORIZE_URL={{ .OIDC.AuthorizationEndpoint }}
OAUTH_TOKEN_URL={{ .OIDC.TokenEndpoint }}
OAUTH_USERINFO_URL={{ .OIDC.UserinfoEndpoint }}
# Pocket ID's end session endpoint, from the discovery document of v2.14.0,
# the version the pocket-id blueprint was written against. The toolkit gives
# a template no end session endpoint of its own, so it is spelled from the
# issuer.
OAUTH_LOGOUT_URL={{ .OIDC.Issuer }}/api/oidc/end-session
# The groups Wiki.js keeps in step with Pocket ID, comma separated; the
# blueprint's checks refuse a name this line could not carry bare.
ADMIN_GROUP={{ envquote .OIDCAdminGroup }}
MEMBER_GROUP={{ envquote .OIDCMemberGroup }}
SYNCED_GROUPS={{ range $i, $g := .SettingList "synced_groups" }}{{ if $i }},{{ end }}{{ $g }}{{ end }}
# The paths a guest may read, comma separated and bare as SYNCED_GROUPS is;
# empty, the wiki is sign in only.
GUEST_PATHS={{ range $i, $p := .SettingList "guest_paths" }}{{ if $i }},{{ end }}{{ $p }}{{ end }}
# Where the bootstrap pushes its state every minute: the ping route of every
# monitor, space separated, empty with none. The token is the whole
# credential, which is why this file is a secret one.
HEARTBEAT_URLS={{ .HeartbeatURLs }}
SITE_TITLE={{ envquote (.Setting "site_title" "Wiki") }}
SITE_DESCRIPTION={{ envquote (.Setting "site_description" "") }}
LOGO_URL={{ envquote (.Setting "logo_url" "") }}
UPLOAD_MAX_MB={{ .SettingInt "upload_max_mb" 5 }}
