# Rendered by paisans. Do not edit.
#
# This file is a build artifact. `paisans apply` renders it and refuses to
# overwrite one that has been modified locally, so an edit here is lost work at
# best. Change {{ configFile }} or secrets.enc.yaml instead.
#
# Changing a value means recreating the container. Compose passes environment
# at start, so `docker compose restart` will not pick it up.
#
# Every name below was read from the paisans fork at tag v1.13.3+paisans:
# .env.example_docker for the names and config/ for where each is used. The
# image bakes that example in as its own .env and compiles it at build time,
# so a value derived from another variable there (CORS_ALLOW_ORIGIN,
# MERCURE_PUBLIC_URL, REDIS_DNS, MESSENGER_TRANSPORT_DSN) still holds
# upstream's placeholder hostname and password. Each is therefore set here in
# full rather than left to be derived.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
# The uid:gid the image's entrypoint chowns var/, /data and /config to and then
# runs as. The entrypoint reads it from the process environment, not from
# Symfony's, so without it the chown and the privilege drop both fail and the
# container exits.
MBIN_USER=1000:1000
KBIN_DOMAIN={{ .Hostname }}
TRUSTED_PROXIES={{ .TrustedProxies }}
APP_SECRET={{ .Secret "app_secret" }}
CORS_ALLOW_ORIGIN='^https?://({{ regexquote .Hostname }}|127\.0\.0\.1)(:[0-9]+)?$'

# Authorized fetch: Mbin refuses an ActivityPub GET that carries no valid HTTP
# signature, except for the instance actor and discovery, which a peer needs
# before it can sign anything (AuthorizedFetchSubscriber.php:52-59 at
# v1.15.0+paisans). On unless settings.authorized_fetch is false, and locked
# below, so an admin cannot turn it off from Mbin's settings page.
MBIN_AUTHORIZED_FETCH={{ yesno .AuthorizedFetch }}

{{- if .Gated }}

# The allow list, because this app is behind the visibility gate. The gate
# sends every ActivityPub request here without a session, so Mbin must refuse
# a read not signed by an instance on its allow list, and read only from
# those. An empty allow list federates with nobody until an admin adds a peer.
# validate refuses a gated Mbin with authorized_fetch false.
#
# Private instance mode, for the same reason: Mbin's catch-all access rule then
# refuses any request without a signed in user, which closes anonymous /api/*
# reads. The monitor checks that on the app directly.
#
# Both are locked below.
MBIN_USE_FEDERATION_ALLOW_LIST=true
MBIN_PRIVATE_INSTANCE=true
{{- end }}

# Mail. Mbin signs every member in through the identity provider, so it sends
# little: its /contact form, to KBIN_CONTACT_EMAIL, and the few account mails
# it still has (resending an activation link, a password reset, an email
# change), none of which an account the provider controls needs. MAILER_DSN is
# built from the smtp block, this app's own overriding it field by field:
# smtps:// for security tls, and smtp:// with require_tls=true for starttls, so
# nothing is ever sent in plaintext. With no SMTP host it is Symfony's null
# transport, which discards every message, and validate warns
# (mbin-without-smtp).
#
# KBIN_SENDER_EMAIL is the From address of every mail, smtp.from_address, or
# noreply at this app's hostname when none resolves. Mbin always sends it under
# the instance domain as the display name, so from_name is not used.
# KBIN_CONTACT_EMAIL is settings.contact_email, or the sender when that is
# absent, so the contact form reaches whoever reads the sending mailbox.
MAILER_DSN={{ envquote .MailerDSN }}
KBIN_SENDER_EMAIL={{ envquote .MbinSenderEmail }}
KBIN_CONTACT_EMAIL={{ envquote .MbinContactEmail }}

# The Mbin settings this file renders, which the paisans fork then reads from
# here on every read and never from its database: an admin sees each disabled
# in Mbin's settings page, a save does not write it, and the settings API
# refuses to change it. {{ configFile }} stays their only source.
MBIN_LOCKED_SETTINGS={{ .MbinLockedSettings }}

# The database. serverVersion is the cluster's major version; upstream marks
# it as one Doctrine must be told.
DATABASE_URL={{ .DSN }}?serverVersion={{ .PostgresVersion }}&charset=utf8
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}

# Locks. LOCK_DSN is Symfony Lock's default store (config/packages/lock.yaml),
# and it stays flock, a lock file inside one container. Every rate limiter takes
# that default (framework-bundle v7.4.14, FrameworkExtension.php:3465-3466) on
# every vote, post and comment, in FrankenPHP's long lived web workers; a
# database store there would hold a private connection that Doctrine DBAL never
# reopens once HAProxy closes it, and every rate limited request would fail.
# Limiter state is in this site's own Valkey, so a lock across sites buys a
# limiter nothing.
#
# CLUSTER_LOCK_DSN is for the locks that must hold across every consumer on
# every site: the actor update lock and the scheduler lock. It is provisional:
# no paisans fork release reads it yet. The planned fork change gives those two
# a named `cluster` lock resource, an advisory lock store built on a Doctrine
# connection of its own that reconnects, which is why this is a plain
# postgresql:// URL to the same database as DATABASE_URL. Until an image that
# reads it is deployed, nothing does, and those locks stay on flock.
LOCK_DSN=flock
CLUSTER_LOCK_DSN={{ .DSN }}?serverVersion={{ .PostgresVersion }}&charset=utf8

{{- if eq .MbinQueue "rabbitmq" }}
# The message broker, reached through amqproxy on this stack's own network
# (settings.queue: rabbitmq). compose.yaml hands the two RABBITMQ_ variables to
# the broker, and the transport DSN is the same credential seen from the
# application's side. The broker is this site's alone: work it holds is lost
# with the site.
RABBITMQ_DEFAULT_USER=mbin
RABBITMQ_DEFAULT_PASS={{ .Secret "rabbitmq_password" }}
MESSENGER_TRANSPORT_DSN=amqp://mbin:{{ .Secret "rabbitmq_password" }}@amqproxy:5673/%2f/messages
{{- else }}
# The queues, as rows in the database above (Symfony Messenger's Doctrine
# transport on the app's own connection), so work a site has accepted
# survives the site and every site's consumers share it. The paisans fork
# gives each transport in messenger.yaml its own queue_name and drops their
# AMQP options, which the Doctrine transport would refuse.
#
# check_delayed_interval is milliseconds. One consumer reads every queue over
# one session, and a LISTEN/NOTIFY wake-up taken by one queue's receiver is
# lost to the rest, which then wait for this poll (the default is a minute).
# redeliver_timeout is seconds: a message a dead consumer had taken is handed
# out again after it, instead of the default hour. It must stay longer than
# any handler runs.
MESSENGER_TRANSPORT_DSN=doctrine://default?check_delayed_interval=1000&redeliver_timeout=900
{{- end }}

# The cache. compose.yaml passes VALKEY_PASSWORD on valkey's command line, and
# Symfony's cache reads REDIS_DNS (config/packages/cache.yaml), not the
# password on its own.
VALKEY_PASSWORD={{ .Secret "valkey_password" }}
REDIS_DNS=redis://{{ .Secret "valkey_password" }}@valkey:6379

# Mercure, Mbin's live update hub, built into the same FrankenPHP image. The
# image's Caddyfile reads the two JWT keys; the application signs with
# MERCURE_JWT_SECRET. MERCURE_URL is how the application and the messenger
# consumers reach the hub, over this stack's own network by service name.
MERCURE_URL=http://app:{{ .App.Port }}/.well-known/mercure
MERCURE_PUBLIC_URL={{ .PublicURL }}/.well-known/mercure
MERCURE_JWT_SECRET={{ .Secret "mercure_jwt_secret" }}
MERCURE_PUBLISHER_JWT_KEY={{ .Secret "mercure_jwt_secret" }}
MERCURE_SUBSCRIBER_JWT_KEY={{ .Secret "mercure_jwt_secret" }}

# Mbin's own OAuth2 server, for API clients, which is not the sign in below.
# The two key paths are upstream's defaults; compose.yaml mounts oauth/ there.
# OAUTH_PASSPHRASE opens oauth/private.pem, which init generated encrypted
# with it.
OAUTH_PRIVATE_KEY=%kernel.project_dir%/config/oauth2/private.pem
OAUTH_PUBLIC_KEY=%kernel.project_dir%/config/oauth2/public.pem
OAUTH_PASSPHRASE={{ .Secret "oauth_passphrase" }}
OAUTH_ENCRYPTION_KEY={{ .Secret "oauth_encryption_key" }}

{{ if .LocalStorage -}}
# Media on this site's own disk (storage: local, or no Garage in the
# deployment). S3_KEY is left out, so the image's entrypoint keeps the local
# adapter, which writes under public/media, and compose.yaml binds media/
# there. The web server in this same container serves it as static files, so
# the URL is this app's own hostname under /media, which is what upstream's
# Docker guide sets (docs/02-admin/01-installation/02-docker.md, "Uploaded
# media files", at the paisans fork's tag v1.14.0+paisans). A federating
# instance caches what it finds here.
KBIN_STORAGE_URL={{ .PublicURL }}/media
{{- else -}}
# Object storage. The image's entrypoint switches uploads to the S3 adapter
# when S3_KEY is set and APP_ENV is prod (the image's own default), in app and
# messenger alike. That is the only switch; nothing overrides the file it edits.
# S3_VERSION is the AWS SDK's API version, and upstream's S3 documentation
# sets it to latest.
S3_KEY={{ .S3.AccessKeyID }}
S3_SECRET={{ .S3.SecretKey }}
S3_BUCKET={{ .S3.Bucket }}
S3_REGION={{ .S3.Region }}
S3_ENDPOINT={{ .S3.Endpoint }}
S3_VERSION=latest
# Mbin builds every media URL and every Liip Imagine thumbnail root from this,
# so it is the public base rather than the endpoint uploads are written to. A
# federating instance caches what it finds here.
#
# This app's own media hostname, with no bucket in the path: the gateway
# resolves the bucket from the hostname, so the path is the object key.
KBIN_STORAGE_URL={{ .S3.PublicBase }}
{{- end }}
{{- if .OIDC.Present }}
# Single sign on, pointed straight at the identity provider. Every endpoint is
# discovered from {issuer}/.well-known/openid-configuration, so the issuer is
# the only URL to set. The client's callback at the provider must be the
# fork's oauth_oidc_verify route,
#
#   {{ .OIDC.RedirectURL }}
#
# and the client must have PKCE enabled, because Mbin always sends a code
# challenge.
#
# The generic OIDC provider is the paisans fork's, which this kind's default
# image is. Upstream Mbin ships only named providers (keycloak, zitadel,
# authentik), so an app that declares an upstream image under `images` gets
# none of these variables read, and has no way to sign in through the provider.
OAUTH_OIDC_ISSUER={{ .OIDC.Issuer }}
OAUTH_OIDC_ID={{ .OIDC.ClientID }}
OAUTH_OIDC_SECRET={{ .OIDC.ClientSecret }}
# The two groups the fork reads from the `groups` claim
# (.env.example_docker:243-273): members of the first become administrators
# on sign in, and a person outside the second is refused. They are
# apps.<app>.settings.admin_group and member_group, with the toolkit's
# defaults, and the client at Pocket ID is restricted to exactly these two,
# so a refused member is stopped there first. Setting either here by hand
# would make the client and the app disagree about who may sign in.
OAUTH_OIDC_ADMIN_GROUP={{ .OIDCAdminGroup }}
OAUTH_OIDC_MEMBER_GROUP={{ .OIDCMemberGroup }}
# Sign in is the identity provider's alone. Without this, Mbin's own password
# registration at /register stays open (the image's defaults leave
# SSO_ONLY_MODE empty and KBIN_REGISTRATIONS_ENABLED true), so anyone who can
# reach it could make an account the provider and its member group never see,
# and with working mail its verification email arrives. SSO_ONLY_MODE closes
# /register (RegisterController.php:29) and hides the password form; accounts
# are still made on first sign in, which MBIN_SSO_REGISTRATIONS_ENABLED leaves
# on. The database setting it feeds is MBIN_SSO_ONLY_MODE, which
# MBIN_LOCKED_SETTINGS names.
SSO_ONLY_MODE=true
{{- end }}
