# Rendered by paisans. Do not edit.
#
# A build artifact: `paisans apply` renders it and refuses to overwrite one
# that has been modified locally. Change {{ configFile }} or secrets.enc.yaml.
#
# Changing a value means recreating the container, since Compose passes
# environment at start.
PAISANS_APP={{ .App.Name }}
PAISANS_SITE={{ .App.Site }}
URL={{ .PublicURL }}
TRUSTED_PROXIES={{ .TrustedProxies }}
DATABASE_URL={{ .DSN }}
# SECRET_KEY encrypts fields in the database; a new one makes them
# unreadable. UTILS_SECRET signs Outline's own maintenance requests.
SECRET_KEY={{ .Secret "outline_secret_key" }}
UTILS_SECRET={{ .Secret "utils_secret" }}
# The Valkey beside the app. compose.yaml passes the same password to
# valkey-server, which reads it from this file.
VALKEY_PASSWORD={{ .Secret "redis_password" }}
REDIS_URL=redis://:{{ .Secret "redis_password" }}@valkey:6379
{{- if .App.Pinned }}
POSTGRES_PASSWORD={{ .DBPassword }}
{{- end }}
{{- if .LocalStorage }}
# Attachments on this site's own disk (storage: local, or no Garage in the
# deployment). Outline's server then reads and writes them itself and answers
# every read through its own API on this app's hostname, so there is no
# bucket, no media hostname and no presigned URL. The root is the image's
# own default and the path it declares as a VOLUME, which compose.yaml binds
# under data/: FILE_STORAGE and FILE_STORAGE_LOCAL_ROOT_DIR in server/env.ts,
# and the backend chosen from the first in server/storage/files/index.ts, at
# 65be53c, the commit outlinewiki/outline:1.10.0 is built from.
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
{{- else }}
FILE_STORAGE=s3
AWS_ACCESS_KEY_ID={{ .S3.AccessKeyID }}
AWS_SECRET_ACCESS_KEY={{ .S3.SecretKey }}
AWS_REGION={{ .S3.Region }}
AWS_S3_UPLOAD_BUCKET_NAME={{ .S3.Bucket }}
# Public, and load bearing for uploads as well as reads. Outline's server does
# not write bytes to S3 on a user's behalf: it issues a presigned POST that the
# browser submits directly against this URL, so it has to be browser reachable
# rather than the mesh endpoint. An upload here travels browser to gateway to
# Garage, not server to Garage the way Mbin's does.
#
# It is this app's own media hostname, which the gateway sends to Garage's S3
# API with Host unchanged, never to the anonymous web endpoint. Outline also
# uses it as its S3 client's endpoint, so it is the host every presigned URL
# is signed for.
AWS_S3_UPLOAD_BUCKET_URL={{ .S3.PublicBase }}
# Path style, and here it is required rather than a preference. The media
# hostname is not under Garage's S3 root domain, so Garage reads the bucket
# from the path; virtual host style would put the bucket in a hostname
# ({{ .S3.Bucket }}.{{ .S3.MediaHostname }}) that has no DNS record, no
# certificate and no host block.
AWS_S3_FORCE_PATH_STYLE={{ yesno .S3.ForcePathStyle }}
{{- end }}
{{- if .OIDC.Present }}
# Outline takes each endpoint individually rather than discovering them.
OIDC_CLIENT_ID={{ .OIDC.ClientID }}
OIDC_CLIENT_SECRET={{ .OIDC.ClientSecret }}
OIDC_AUTH_URI={{ .OIDC.AuthorizationEndpoint }}
OIDC_TOKEN_URI={{ .OIDC.TokenEndpoint }}
OIDC_USERINFO_URI={{ .OIDC.UserinfoEndpoint }}
OIDC_USERNAME_CLAIM=preferred_username
OIDC_SCOPES=openid profile email
{{- end }}
